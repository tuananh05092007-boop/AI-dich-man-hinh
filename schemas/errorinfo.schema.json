{
  "$defs": {
    "ErrorCode": {
      "enum": [
        "timeout",
        "network_error",
        "auth_error",
        "rate_limited",
        "model_unavailable",
        "invalid_request",
        "invalid_response",
        "resource_exhausted",
        "engine_error",
        "internal_error"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "PipelineComponent": {
      "enum": [
        "capture",
        "preprocessing",
        "region_detection",
        "ocr",
        "normalization",
        "tracking",
        "context",
        "translation",
        "translation_memory",
        "overlay",
        "storage",
        "app"
      ],
      "title": "PipelineComponent",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Structured, secret-free error description.\n\n``message`` is passed through :func:`redact_secrets`. No tracebacks, request headers or\nfree-form dictionaries are carried.",
  "properties": {
    "code": {
      "$ref": "#/$defs/ErrorCode"
    },
    "component": {
      "$ref": "#/$defs/PipelineComponent"
    },
    "error_type": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Type"
    },
    "message": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "retryable": {
      "default": false,
      "title": "Retryable",
      "type": "boolean"
    },
    "status_code": {
      "anyOf": [
        {
          "maximum": 599,
          "minimum": 100,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status Code"
    }
  },
  "required": [
    "code",
    "component",
    "message"
  ],
  "title": "ErrorInfo",
  "type": "object"
}
