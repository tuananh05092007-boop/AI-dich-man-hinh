{
  "$defs": {
    "BoundingBox": {
      "additionalProperties": false,
      "description": "Axis-aligned rectangle in *monitor-relative* physical pixels.\n\nOrigin is the top-left pixel of the monitor named by ``monitor_id``; x grows right and y\ngrows down. The box is half-open: it covers pixels ``x1 <= x < x2`` and ``y1 <= y < y2``,\nso ``width = x2 - x1``. Coordinates are never virtual-desktop coordinates.",
      "properties": {
        "monitor_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Monitor Id",
          "type": "string"
        },
        "x1": {
          "minimum": 0,
          "title": "X1",
          "type": "integer"
        },
        "x2": {
          "minimum": 0,
          "title": "X2",
          "type": "integer"
        },
        "y1": {
          "minimum": 0,
          "title": "Y1",
          "type": "integer"
        },
        "y2": {
          "minimum": 0,
          "title": "Y2",
          "type": "integer"
        }
      },
      "required": [
        "monitor_id",
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "FrameBufferRef": {
      "additionalProperties": false,
      "description": "Lightweight reference to pixels held in the capture module's frame pool.\n\nPixels are never copied through queues. Ownership stays with the capture module's pool:\nconsumers treat the buffer as read-only and must release it through the capture interface.\n``slot_generation`` changes whenever the slot is recycled, so a stale reference is detectable.\nA reference is process-local and must not be persisted or sent across processes.",
      "properties": {
        "pool_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Pool Id",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "slot": {
          "minimum": 0,
          "title": "Slot",
          "type": "integer"
        },
        "slot_generation": {
          "minimum": 1,
          "title": "Slot Generation",
          "type": "integer"
        },
        "stride_bytes": {
          "exclusiveMinimum": 0,
          "title": "Stride Bytes",
          "type": "integer"
        }
      },
      "required": [
        "pool_id",
        "slot",
        "slot_generation",
        "stride_bytes",
        "size_bytes"
      ],
      "title": "FrameBufferRef",
      "type": "object"
    },
    "PixelFormat": {
      "enum": [
        "bgra8",
        "bgr8",
        "rgb8",
        "gray8"
      ],
      "title": "PixelFormat",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One captured full-monitor frame.\n\n``width``/``height`` are the monitor's physical pixel size, so monitor-relative bounding\nboxes map 1:1 onto frame pixels. Cropped ROI images are internal to preprocessing and are\nnot contracts.",
  "properties": {
    "buffer": {
      "$ref": "#/$defs/FrameBufferRef"
    },
    "captured_at": {
      "description": "Timezone-aware UTC ISO-8601 timestamp (serialized with 'Z').",
      "format": "date-time",
      "pattern": "(Z|\\+00:00)$",
      "title": "Captured At",
      "type": "string"
    },
    "captured_monotonic_ns": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Process-local monotonic clock; for latency only, never persisted.",
      "title": "Captured Monotonic Ns"
    },
    "dirty_regions": {
      "items": {
        "$ref": "#/$defs/BoundingBox"
      },
      "maxItems": 256,
      "title": "Dirty Regions",
      "type": "array"
    },
    "frame_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Frame Id",
      "type": "string"
    },
    "height": {
      "exclusiveMinimum": 0,
      "title": "Height",
      "type": "integer"
    },
    "monitor_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Monitor Id",
      "type": "string"
    },
    "pixel_format": {
      "$ref": "#/$defs/PixelFormat"
    },
    "schema_version": {
      "const": "0.2",
      "default": "0.2",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "description": "Per-monitor, strictly increasing.",
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "width": {
      "exclusiveMinimum": 0,
      "title": "Width",
      "type": "integer"
    }
  },
  "required": [
    "frame_id",
    "sequence",
    "monitor_id",
    "width",
    "height",
    "pixel_format",
    "captured_at",
    "buffer"
  ],
  "title": "CapturedFrame",
  "type": "object"
}
