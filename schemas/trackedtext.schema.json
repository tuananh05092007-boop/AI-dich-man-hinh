{
  "$defs": {
    "BoundingBox": {
      "additionalProperties": false,
      "description": "Axis-aligned rectangle in *monitor-relative* physical pixels.\n\nOrigin is the top-left pixel of the monitor named by ``monitor_id``; x grows right and y\ngrows down. The box is half-open: it covers pixels ``x1 <= x < x2`` and ``y1 <= y < y2``,\nso ``width = x2 - x1``. Coordinates are never virtual-desktop coordinates.",
      "properties": {
        "monitor_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Monitor Id",
          "type": "string"
        },
        "x1": {
          "minimum": 0,
          "title": "X1",
          "type": "integer"
        },
        "x2": {
          "minimum": 0,
          "title": "X2",
          "type": "integer"
        },
        "y1": {
          "minimum": 0,
          "title": "Y1",
          "type": "integer"
        },
        "y2": {
          "minimum": 0,
          "title": "Y2",
          "type": "integer"
        }
      },
      "required": [
        "monitor_id",
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "ChangeKind": {
      "enum": [
        "new",
        "unchanged",
        "appended",
        "modified",
        "replaced"
      ],
      "title": "ChangeKind",
      "type": "string"
    },
    "LifecycleState": {
      "enum": [
        "NO_TEXT",
        "TEXT_DETECTED",
        "TEXT_STABILIZING",
        "TRANSLATION_PENDING",
        "TRANSLATING",
        "DISPLAYING",
        "TEXT_CHANGED",
        "CLEAR_PENDING",
        "CLEARED",
        "ERROR"
      ],
      "title": "LifecycleState",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Snapshot of one subtitle tracked across frames (owned by the tracker).",
  "properties": {
    "bbox": {
      "$ref": "#/$defs/BoundingBox"
    },
    "change_kind": {
      "$ref": "#/$defs/ChangeKind"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "first_seen_at": {
      "description": "Timezone-aware UTC ISO-8601 timestamp (serialized with 'Z').",
      "format": "date-time",
      "pattern": "(Z|\\+00:00)$",
      "title": "First Seen At",
      "type": "string"
    },
    "generation_id": {
      "minimum": 1,
      "title": "Generation Id",
      "type": "integer"
    },
    "generation_started_at": {
      "description": "Timezone-aware UTC ISO-8601 timestamp (serialized with 'Z').",
      "format": "date-time",
      "pattern": "(Z|\\+00:00)$",
      "title": "Generation Started At",
      "type": "string"
    },
    "last_frame_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Frame Id"
    },
    "last_seen_at": {
      "description": "Timezone-aware UTC ISO-8601 timestamp (serialized with 'Z').",
      "format": "date-time",
      "pattern": "(Z|\\+00:00)$",
      "title": "Last Seen At",
      "type": "string"
    },
    "observation_count": {
      "minimum": 1,
      "title": "Observation Count",
      "type": "integer"
    },
    "region_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Region Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "similarity": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Similarity to the previous generation's text; None if new.",
      "title": "Similarity"
    },
    "state": {
      "$ref": "#/$defs/LifecycleState"
    },
    "subtitle_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Subtitle Id",
      "type": "string"
    },
    "text": {
      "maxLength": 8192,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "subtitle_id",
    "generation_id",
    "region_id",
    "text",
    "bbox",
    "state",
    "first_seen_at",
    "generation_started_at",
    "last_seen_at",
    "confidence",
    "change_kind",
    "observation_count"
  ],
  "title": "TrackedText",
  "type": "object"
}
